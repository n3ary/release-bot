# Build scripts that pnpm 11+ is allowed to run during install.
# This is the pnpm 11+ replacement for the deprecated
# `pnpm.onlyBuiltDependencies` field in package.json. The
# [pnpm] section header scopes the config to pnpm only, so
# npm ignores it (no warning when `npx wrangler` reads the
# .npmrc).
[pnpm]
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=workerd
